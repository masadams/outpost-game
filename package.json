{
  "name": "outpost",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bot": "vitest run --config vitest.bot.config.ts",
    "benchmark": "vitest bench --run",
    "test:browser": "playwright test",
    "test:preview": "playwright test --config playwright.preview.config.ts"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "phaser": "^3.90.0",
    "preact": "10.24.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
